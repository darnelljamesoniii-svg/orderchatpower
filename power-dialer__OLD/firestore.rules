rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()             { return request.auth != null; }
    function isOwner(uid)         { return request.auth.uid == uid; }
    function isSupervisor()       {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    // Users — supervisors manage, reps read own
    match /users/{uid} {
      allow read:   if isAuth() && (isOwner(uid) || isSupervisor());
      allow create: if false; // Admin SDK only (create-user API route)
      allow update: if isSupervisor();
      allow delete: if false;
      allow list:   if isSupervisor();
    }

    // Leads — agents read/update, only Admin SDK creates
    match /leads/{leadId} {
      allow read:   if isAuth();
      allow update: if isAuth();
      allow create: if false;
      allow delete: if false;
    }

    // Agents
    match /agents/{agentId} {
      allow read:  if isAuth();
      allow write: if isAuth();

      match /alerts/{alertId} {
        allow read:   if isAuth() && isOwner(agentId);
        allow write:  if false;
        allow list:   if isAuth() && isOwner(agentId);
        allow delete: if isAuth() && isOwner(agentId);
      }
    }

    // Dispositions + Campaigns
    match /dispositions/{docId} {
      allow read:  if isAuth();
      allow write: if isSupervisor();
    }
    match /campaigns/{docId} {
      allow read:  if isAuth();
      allow write: if isSupervisor();
    }

    // Call logs
    match /call_logs/{logId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // Email logs — read by supervisors only
    match /email_logs/{logId} {
      allow read:   if isSupervisor();
      allow write:  if false;
    }

    // LP Sessions — public write to own session, agent read
    match /lp_sessions/{sessionId} {
      allow create: if request.resource.data.sessionId == sessionId;
      allow update: if resource.data.sessionId == sessionId;
      allow list:   if false;
      allow read:   if isAuth();
      allow delete: if false;
    }

    // Settings — supervisor only
    match /settings/{docId} {
      allow read:  if isAuth();
      allow write: if isSupervisor();
    }

    // Zones
    match /zones/{zoneId} {
      allow read:  if true;
      allow write: if false;
    }
  }
}
