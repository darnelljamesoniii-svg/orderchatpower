# ─────────────────────────────────────────────────────────────────────────────
#  POWER DIALER CRM — Environment Variables
#  Copy this file to .env.local and fill in every value before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (Client SDK — safe to expose) ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Firebase Admin SDK (server-only — NEVER expose to client) ─────────────────
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ── SignalWire ────────────────────────────────────────────────────────────────
# Found at: https://your-space.signalwire.com → Settings → Credentials
SIGNALWIRE_SPACE_URL=yourspace.signalwire.com
SIGNALWIRE_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SIGNALWIRE_API_TOKEN=PTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SIGNALWIRE_PHONE_NUMBER=+15550000000

# REST API Token for server-side calls (same as API_TOKEN in most cases)
SIGNALWIRE_REST_API_TOKEN=PTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...

# ── Square ────────────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=EAAAl...
SQUARE_LOCATION_ID=your_location_id
SQUARE_BASE_URL=https://connect.squareupsandbox.com

# ── Google Places & Maps ──────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIzaSy...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_SECRET=change_me_to_a_long_random_string

# ── First Supervisor Account (used by setup.mjs to create initial login) ──────
# Set these before running: node setup.mjs
SUPERVISOR_EMAIL=you@yourdomain.com
SUPERVISOR_NAME=Your Name

# ── Resend Email ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@agenticlife.com
EMAIL_REPLY_TO=team@agenticlife.com
